{
  "name": "fairlend-content-requests",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run auth:sync-dev && convex dev --codegen disable --start \"vite dev --port 3000\"",
    "dev:web": "vite dev --port 3000",
    "auth:sync-dev": "bun scripts/sync-convex-workos-env.ts",
    "content-requests": "bun src/cli/content-requests.ts",
    "scout:orchestrate": "bun scripts/orchestrate-scout-report.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --mode e2e",
    "deploy": "bun run build && wrangler deploy",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract convex/*.test.ts",
    "validate:migrations": "vitest run convex/migrations.test.ts --maxWorkers=1",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:a11y": "APPLICATION_AUDIT_ENFORCE=true APPLICATION_AUDIT_LABEL=ci bunx playwright test tests/e2e/application-quality.spec.ts",
    "test:e2e:a11y:dark": "APPLICATION_AUDIT_ENFORCE=true APPLICATION_AUDIT_LABEL=ci-dark APPLICATION_AUDIT_THEME=dark bunx playwright test tests/e2e/application-quality.spec.ts",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check:format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run validate:migrations && bun run build"
  },
  "dependencies": {
    "@automerge/automerge": "^3.3.2",
    "@automerge/automerge-repo": "^2.5.6",
    "@automerge/automerge-repo-network-broadcastchannel": "^2.5.6",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.6",
    "@base-ui/react": "^1.6.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@convex-dev/react-query": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.30",
    "@tanstack/router-plugin": "1.168.22",
    "@workos-inc/node": "^10.8.0",
    "@workos/authkit-tanstack-react-start": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.3",
    "convex-timeline": "^0.1.2",
    "cookie-es": "^3.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-sha256": "^1.3.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "motion": "^12.41.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.61.1",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "convex-test": "^0.0.54",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^28.1.0",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  }
}

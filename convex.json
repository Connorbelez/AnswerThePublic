{
  "$schema": "https://raw.githubusercontent.com/get-convex/convex-backend/refs/heads/main/npm-packages/convex/schemas/convex.schema.json",
  "functions": "convex/",
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": ["http://localhost:3000/api/auth/callback"],
        "appHomepageUrl": "http://localhost:3000",
        "corsOrigins": ["http://localhost:3000"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "WORKOS_REDIRECT_URI": "http://localhost:3000/api/auth/callback"
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": [
          "https://fairlend-content-requests.vercel.app/api/auth/callback"
        ],
        "appHomepageUrl": "https://fairlend-content-requests.vercel.app",
        "corsOrigins": ["https://fairlend-content-requests.vercel.app"]
      }
    }
  }
}

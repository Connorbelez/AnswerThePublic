# TanStack Start / Convex
CONVEX_DEPLOYMENT="dev:your-deployment"
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
# WorkOS AuthKit server configuration
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
WORKOS_ENVIRONMENT_ID="environment_..."
# Server-only Convex deploy key. Never expose through a VITE_ variable.
FAIRLEND_CONVEX_AGENT_ADMIN_KEY="prod:deployment|admin-key-for-workos-agent-acting-as"
# Exact browser origins permitted to call the private ChatGPT MCP endpoint.
FAIRLEND_CHATGPT_ALLOWED_ORIGINS="https://chatgpt.com,https://chat.openai.com"
# Generate with: openssl rand -base64 48
FAIRLEND_CHATGPT_CONFIRMATION_SECRET="replace-with-at-least-32-random-characters"
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-random-characters"
WORKOS_ORGANIZATION_ID="org_..."
# Verified founder email used by the administrator QA workspace projection.
FAIRLEND_ELIE_EMAIL="elie@fairlend.ca"

# Set the same organization ID in the Convex deployment:
FAIRLEND_WORKOS_ORGANIZATION_ID="org_..."
# Generate a shared server/Convex secret with: openssl rand -base64 32
FAIRLEND_PRINCIPAL_PROVISIONING_KEY="replace-with-random-secret"
# Convex-only HMAC key. Generate once with: openssl rand -hex 32
PUBLIC_SHARE_TOKEN_SECRET="replace-with-64-hex-character-secret"
# Convex-only verifier key. Provision with `convex env set`; rotation invalidates active guest links.
GUEST_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-bytes"
# Shared only by the TanStack server and Convex resolve mutation. Never expose through VITE_.
GUEST_ACCESS_RESOLVE_SECRET="replace-with-a-distinct-32-byte-random-secret"
# Convex-only final-window threshold for unfinished grant notifications. Defaults to 12.
GUEST_ACCESS_EXPIRY_NOTIFICATION_THRESHOLD_HOURS="12"
# Convex-only HMAC key for exact synthesis processing snapshots. Falls back to
# GUEST_ACCESS_TOKEN_SECRET during migration; provision a distinct key in production.
EXPERT_SYNTHESIS_SNAPSHOT_SECRET="replace-with-a-distinct-32-byte-random-secret"

# Authenticated deep links and transactional email dispatcher
FAIRLEND_APP_URL="https://content-requests.example"
# Dedicated, revocable WorkOS agent installation credential for unattended
# Content Request ingestion. Never embed this value in an automation prompt.
CONTENT_REQUESTS_ACCESS_TOKEN="wk_agent_..."
# Optional CLI override. The orchestrator falls back to FAIRLEND_APP_URL.
CONTENT_REQUESTS_API_URL="https://content-requests.example"
FAIRLEND_TRANSACTIONAL_EMAIL_ENDPOINT="https://email-provider.example/send-template"
FAIRLEND_TRANSACTIONAL_EMAIL_API_KEY="replace-with-provider-key"

# OpenAI-compatible audio transcription endpoint used by the Convex action
FAIRLEND_TRANSCRIPTION_API_URL="https://api.openai.com/v1/audio/transcriptions"
FAIRLEND_TRANSCRIPTION_API_KEY="replace-with-provider-key"
FAIRLEND_TRANSCRIPTION_MODEL="whisper-1"
